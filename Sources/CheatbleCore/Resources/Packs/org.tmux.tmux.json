      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "기본 1칸 단위입니다."
    },
    {
      "id": "tmux.resizeRight",
      "title": "오른쪽으로 크기 조절",
      "category": "패널 크기",
      "keys": "Control+B → Control+Right",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "기본 1칸 단위입니다."
    },
    {
      "id": "tmux.resizeUp",
      "title": "위쪽으로 크기 조절",
      "category": "패널 크기",
      "keys": "Control+B → Control+Up",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "기본 1칸 단위입니다."
    },
    {
      "id": "tmux.resizeDown",
      "title": "아래쪽으로 크기 조절",
      "category": "패널 크기",
      "keys": "Control+B → Control+Down",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "기본 1칸 단위입니다."
    },
    {
      "id": "tmux.copyMode",
      "title": "복사·스크롤 모드",
      "category": "복사·스크롤",
      "keys": "Control+B → [",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "이후 조작은 mode-keys 설정(emacs/vi)에 따라 달라집니다."
    },
    {
      "id": "tmux.copyPageUp",
      "title": "복사 모드에서 위로",
      "category": "복사·스크롤",
      "keys": "Control+B → PageUp",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.paste",
      "title": "최근 버퍼 붙여넣기",
      "category": "복사·스크롤",
      "keys": "Control+B → ]",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.bufferList",
      "title": "붙여넣을 버퍼 선택",
      "category": "복사·스크롤",
      "keys": "Control+B → =",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.refresh",
      "title": "화면 다시 그리기",
      "category": "도움말",
      "keys": "Control+B → R",
      "sourceURL": "https://man.openbsd.org/tmux"
    }
  ]
}
