{
  "schemaVersion": 1,
  "bundleIdentifier": "org.tmux.tmux",
  "appName": "tmux",
  "shortcuts": [
    {
      "id": "tmux.help",
      "title": "전체 키 목록",
      "category": "도움말",
      "keys": "Control+B → Shift+/",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "기본 prefix Ctrl+B를 누르고 놓은 뒤 ?를 입력합니다. 기호 키는 US 키보드 기준입니다."
    },
    {
      "id": "tmux.command",
      "title": "명령 입력",
      "category": "도움말",
      "keys": "Control+B → Shift+;",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "Ctrl+B를 누르고 놓은 뒤 :를 입력합니다."
    },
    {
      "id": "tmux.detach",
      "title": "세션에서 분리",
      "category": "세션",
      "keys": "Control+B → D",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "세션의 프로그램은 계속 실행됩니다."
    },
    {
      "id": "tmux.sessions",
      "title": "세션 선택",
      "category": "세션",
      "keys": "Control+B → S",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.renameSession",
      "title": "세션 이름 변경",
      "category": "세션",
      "keys": "Control+B → Shift+4",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "마지막 키는 $입니다."
    },
    {
      "id": "tmux.lastSession",
      "title": "이전 사용 세션",
      "category": "세션",
      "keys": "Control+B → Shift+L",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.newWindow",
      "title": "새 윈도우",
      "category": "윈도우",
      "keys": "Control+B → C",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.windowList",
      "title": "윈도우 선택",
      "category": "윈도우",
      "keys": "Control+B → W",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.nextWindow",
      "title": "다음 윈도우",
      "category": "윈도우",
      "keys": "Control+B → N",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.previousWindow",
      "title": "이전 윈도우",
      "category": "윈도우",
      "keys": "Control+B → P",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.lastWindow",
      "title": "직전 사용 윈도우",
      "category": "윈도우",
      "keys": "Control+B → L",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.window0",
      "title": "0번 윈도우",
      "category": "윈도우",
      "keys": "Control+B → 0",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "숫자 0–9로 해당 번호의 윈도우를 선택합니다."
    },
    {
      "id": "tmux.renameWindow",
      "title": "윈도우 이름 변경",
      "category": "윈도우",
      "keys": "Control+B → ,",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.closeWindow",
      "title": "윈도우 닫기",
      "category": "윈도우",
      "keys": "Control+B → Shift+7",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "& 키입니다. 확인 후 해당 윈도우의 모든 패널과 프로그램을 종료합니다."
    },
    {
      "id": "tmux.splitHorizontal",
      "title": "좌우로 분할",
      "category": "패널",
      "keys": "Control+B → Shift+5",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "% 키입니다."
    },
    {
      "id": "tmux.splitVertical",
      "title": "위아래로 분할",
      "category": "패널",
      "keys": "Control+B → Shift+'",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "큰따옴표 키입니다."
    },
    {
