      "keys": "Control+B → O",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.previousPane",
      "title": "직전 사용 패널",
      "category": "패널",
      "keys": "Control+B → ;",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.left",
      "title": "왼쪽 패널",
      "category": "패널",
      "keys": "Control+B → Left",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.right",
      "title": "오른쪽 패널",
      "category": "패널",
      "keys": "Control+B → Right",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.up",
      "title": "위쪽 패널",
      "category": "패널",
      "keys": "Control+B → Up",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.down",
      "title": "아래쪽 패널",
      "category": "패널",
      "keys": "Control+B → Down",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.numbers",
      "title": "패널 번호 표시",
      "category": "패널",
      "keys": "Control+B → Q",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "표시된 숫자를 누르면 해당 패널을 선택합니다."
    },
    {
      "id": "tmux.zoom",
      "title": "패널 확대 전환",
      "category": "패널",
      "keys": "Control+B → Z",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.layout",
      "title": "다음 배치",
      "category": "패널",
      "keys": "Control+B → Space",
      "sourceURL": "https://man.openbsd.org/tmux"
    },
    {
      "id": "tmux.breakPane",
      "title": "패널을 새 윈도우로",
      "category": "패널",
      "keys": "Control+B → Shift+1",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "! 키입니다."
    },
    {
      "id": "tmux.closePane",
      "title": "패널 닫기",
      "category": "패널",
      "keys": "Control+B → X",
      "sourceURL": "https://man.openbsd.org/tmux",
      "detail": "확인 후 해당 패널의 프로그램을 종료합니다."
    },
    {
      "id": "tmux.resizeLeft",
      "title": "왼쪽으로 크기 조절",
